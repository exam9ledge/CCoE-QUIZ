/* ---------- TEACHER-PACED (phone follows the big screen) ---------- */function teacherRoute() { stopPoll(); P.view = null; pTick(); startPoll(1500, pTick); }async function pTick() {  let q; try { q = await api("quiz_state", { p_code: P.quiz.code }); } catch { return; }  if (!q) return; P.quiz = q; P.off = Date.parse(q.now) - Date.now();  if (q.status === "ended") { stopPoll(); return finishScreen(); }  if (!isTeacher()) { stopPoll(); return route(); }  const L = q.live || {}, ph = q.status === "paused" ? "paused" : q.status === "lobby" ? "lobby" : (L.phase || "between");  const key = ph + ":" + (L.q ?? "") + ":" + (ph === "question" ? "" : L.seq);  if (ph === "question") { P.ends = L.ends_at ? Date.parse(L.ends_at) : null; }  if (P.view === key) return;  P.view = key;  if (ph === "lobby" || ph === "paused") return waitScreen(ph);  if (ph === "between" || ph === "skipped") return waitScreen("between", ph === "skipped" ? "Question skipped by host – next one is coming" : "");  if (ph === "question") return pQuestion(L);  if (ph === "reveal") return pReveal(L);  if (ph === "board") return pBoard();}function pHead(L, extra = "") {  return `<div class="qtop"><span class="chip">Q ${(+L.pos || 0) + 1}/${P.quiz.q_count}</span><span class="chip" id="tsec">${extra}</span><span class="chip gold">⭐ ${fmt(P.me.score)}</span></div>`;}function pQuestion(L) {  const qi = +L.q, done = P.doneSet.has(qi);  app.innerHTML = questionHTML(qi, pHead(L) + `<div class="timer"><i id="tb"></i></div>`);  const btns = [...app.querySelectorAll(".opt")];  const lock = (choice, msg) => {    btns.forEach((b, i) => { b.disabled = true; if (i !== choice) b.classList.add("dim"); });    if ($("#ff")) $("#ff").disabled = true;    $("#lockmsg").innerHTML = `<div class="card center" style="margin-top:12px;padding:14px"><b>${msg}</b><div class="note">The answer appears when the host reveals it.</div></div>`;  };  const mine = P.tChoice?.[qi];  if (done) lock(mine ?? -1, "🔒 Answer locked in!");  else {    b