/* ---- winners: cartoon champions on the podium + applause ---- */function cartoon(shirt, skin, hair, place) {  return `<svg viewBox="0 0 120 170" class="toon t${place}">    <g class="armL"><path d="M38 78 L14 40" stroke="${skin}" stroke-width="11" stroke-linecap="round"/><circle cx="13" cy="37" r="8" fill="${skin}"/></g>    <g class="armR"><path d="M82 78 L106 40" stroke="${skin}" stroke-width="11" stroke-linecap="round"/><circle cx="107" cy="37" r="8" fill="${skin}"/></g>    <rect x="44" y="132" width="13" height="34" rx="6" fill="#1e3a8a"/><rect x="63" y="132" width="13" height="34" rx="6" fill="#1e3a8a"/>    <ellipse cx="50" cy="166" rx="11" ry="5" fill="#111827"/><ellipse cx="70" cy="166" rx="11" ry="5" fill="#111827"/>    <rect x="34" y="70" width="52" height="68" rx="20" fill="${shirt}"/>    <circle cx="60" cy="100" r="11" fill="${["", "#fbbf24", "#d1d5db", "#f59e0b"][place]}" stroke="#fff" stroke-width="3"/><text x="60" y="105" text-anchor="middle" font-size="13" font-weight="800" fill="#3b2500">${place}</text>    <path d="M52 70 L60 90 L68 70" fill="#ef4444"/>    <circle cx="60" cy="44" r="27" fill="${skin}"/>    <path d="M33 40 Q36 14 60 15 Q86 15 88 40 Q76 28 60 30 Q44 28 33 40Z" fill="${hair}"/>    <circle cx="50" cy="45" r="4" fill="#111827"/><circle cx="70" cy="45" r="4" fill="#111827"/>    <circle cx="51.5" cy="43.5" r="1.4" fill="#fff"/><circle cx="71.5" cy="43.5" r="1.4" fill="#fff"/>    <circle cx="43" cy="55" r="5" fill="#fca5a5" opacity=".7"/><circle cx="77" cy="55" r="5" fill="#fca5a5" opacity=".7"/>    <path d="M48 56 Q60 70 72 56 Z" fill="#7f1d1d"/>    ${place === 1 ? `<path d="M42 18 L48 4 L56 14 L60 2 L64 14 L72 4 L78 18 Z" fill="#fbbf24" stroke="#b45309" stroke-width="2"/>` : ""}  </svg>`;}function applause(sec = 5) {  try {    const A = new (window.AudioContext || window.webkitAudioContext)(), now = A.currentTime;    const buf = A.createBuffer(1, A.sampleRate * 0.05, A.sampleRate), d = buf.getChannelData(0);    for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / d.length, 3);    const master = A.createGain(); master.gain.setValueAtTime(0.9, now); master.gain.linearRampToValueAtTime(0, now + sec); master.connect(A.destination);    for (let k = 0; k < sec * 120; k++) {           // many short claps = applause      const s = A.createBufferSource(); s.buffer = buf; s.playbackRate.value = 0.7 + Math.random() * 0.8;      const f = A.createBiquadFilter(); f.type = "bandpass"; f.frequency.value = 900 + Math.random() * 1800; f.Q.value = 0.9;      const g = A.createGain(); g.gain.value = 0.25 + Math.random() * 0.5;      s.connect(f); f.connect(g); g.connect(master); s.start(now + Math.random() * sec);    }    [523.25, 659.25, 783.99, 1046.5].forEach((fr, i) => {   // little fanfare      const o = A.createOscillator(), g = A.createGain(); o.type = "triangle"; o.frequency.value = fr;      g.gain.setValueAtTime(0, now + i * 0.16); g.gain.linearRampToValueAtTime(0.18, now + i * 0.16 + 0.03); g.gain.exponentialRampToValueAtTime(0.001, now + i * 0.16 + (i === 3 ? 0.9 : 0.3));      o.connect(g); g.connect(A.destination); o.start(now + i * 0.16); o.stop(now + i * 0.16 + 1);    });  } catch {}}function celebrate() {  const top = sortedPlayers().slice(0, 3);  if (!top.length) return toast("No players to celebrate yet");  document.querySelectorAll(".podium").forEach(x => x.remove());  const d = document.createElement("div"); d.className = "podium";  const looks = [["#7c3aed", "#f1c27d", "#3b2412"], ["#0ea5e9", "#e0ac69", "#111827"], ["#ec4899", "#c68642", "#4a2c0a"]];  const col = (p, i, h, bg) => p ? `<div class="col" style="animation-delay:${[0.6, 0.3, 0.9][i]}s"><div class="pn">${esc(p.name)}</div><div class="ps">${fmt(p.score)} pts · ${p.correct} correct</div>      ${cartoon(...looks[i], i + 1)}<div class="blk" style="height:${h}px;background:${bg}">${i + 1}</div></div>` : `<div class="col"></div>`;  d.innerHTML = `<div class="center"><div class="ptitle">🏆 Champions 🏆</div>    <div class="pd">${col(top[1], 1, 150, "linear-gradient(#e5e7eb,#9ca3af)")}${col(top[0], 0, 220, "linear-gradient(#fde047,#f59e0b)")}${col(top[2], 2, 110, "linear-gradient(#fdba74,#c2410c)")}</div>    <div style="margin-top:22px;display:flex;gap:10px;justify-content:center"><button class="btn orange" id="pAgain">👏 Clap again</button><button class="btn ghost" id="pClose">Close</button></div></div>`;  document.body.appendChild(d);  d.querySelector("#pClose").onclick = () => d.remove();  d.querySelector("#pAgain").onclick = () => { applause(4); confetti(3000); };  applause(6); confetti(5000); setTimeout(() => confetti(3000), 2500);}async function exportResults() {  try {    await loadScript(LIBS.xlsx); await pollBoard(true);    const stats = await adm("host_stats", { p_code: H.code }) || [];    const all = sortedPlayers();    const ws1 = XLSX.utils.json_to_sheet(all.map((p, i) => ({ Rank: i + 1, Name: p.name, Score: p.score, Correct: p.correct, Wrong: p.wrong,      Answered: p.answered, "Accuracy %": p.answered ? Math.round(p.correct / p.answered * 100) : 0 })));    const sm = new Map(stats.map(s => [s.i, s]));    const ws2 = XLSX.utils.json_to_sheet(H.quiz.questions.map(q => { const s = sm.get(q.i) || { n: 0, ok: 0 };      return { "Q No": q.i + 1, Question: q.q, "Time (sec)": effTime(H.quiz.settings, q) || "", "Correct Answer": LET[q.a] + ") " + q.o[q.a], Attempts: s.n, Correct: s.ok, "Accuracy %": s.n ? Math.round(s.ok / s.n * 100) : "" }; }));    const wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, ws1, "Leaderboard"); XLSX.utils.book_append_sheet(wb, ws2, "Question Stats");    XLSX.writeFile(wb, `QuizBlast_${H.code}_results.xlsx`);  } catch (e) { admErr(e); }}
