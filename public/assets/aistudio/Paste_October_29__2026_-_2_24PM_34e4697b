hState();  route();}async function refreshState() { try { const q = await api("quiz_state", { p_code: P.quiz.code }); if (q) { P.quiz = q; P.off = Date.parse(q.now) - Date.now(); } } catch {} }function stopPoll() { clearInterval(P.pollId); P.pollId = null; clearInterval(P.timerId); }function startPoll(ms, fn) { clearInterval(P.pollId); P.pollId = setInterval(fn, ms); }function route() {  const st = P.quiz.status;  if (st === "ended") return finishScreen();  if (isTeacher()) return teacherRoute();  if (P.me.finished || P.doneSet.size >= P.quiz.q_count) return finishScreen();  if (st === "lobby" || st === "paused") return waitScreen(st);  nextQuestion();}function waitScreen(st, sub) {  clearInterval(P.timerId);  app.innerHTML = brand() + `<div class="card center">    <div class="big-emoji pulse">${st === "paused" ? "⏸️" : st === "between" ? "⏳" : "🎉"}</div>    <h2>${st === "paused" ? "Quiz paused by host" : st === "between" ? "Get ready…" : "You're in, " + esc(P.me.name) + "!"}</h2>    <p class="sub">${sub || (st === "paused" ? "Hold on, it will continue shortly" : st === "between" ? "The next question is coming" : "See your name on the big screen? Waiting for the host to start")}<span class="dots"></span></p>    <div class="chip gold" style="margin-top:6px">⭐ ${fmt(P.me.score)} · Code ${esc(P.quiz.code)}</div></div>`;  if (!isTeacher()) startPoll(3000, async () => { await refreshState(); if (P.quiz.status !== st) { stopPoll(); route(); } });}
/* ---------- shared question view (both modes) ---------- */function questionHTML(qi, head) {  const q = P.qs[qi], lim = +P.quiz.settings?.lifelines || 0, left = Math.max(0, lim - (P.fiftyUsed || 0));  return `${head}    <div class="qcard">${q.t ? `<span class="tag">${esc(q.t)}</span>` : ""}<div class="qt">${esc(q.q)}</div></div>    <div class="opts">${q.o.map((o, i) => `<button class="opt" data-i="${i}" style="background:var(--o${i % 5})"><span class="L">${LET[i]}</span><span>${esc(o)}</span></button>`).join("")}</div>    ${lim && q.o.length >= 3 ? `<button class="btn orange block fifty" id="ff" ${P.fifty[qi] || !left ? "disabled" : ""}>🎯 50:50 <span style="font-weight:600;font-size:14px">(${left} left)</span></button>` : ""}    <div id="lockmsg"></div>`;}function applyFifty(qi) {  (P.fifty[qi] || []).forEach(i => { const b = app.querySelector(`.opt[data-i="${i}"]`); if (b) { b.classList.add("gone"); b.disabled = true; } });}function wireFifty(qi) {  applyFifty(qi);  const ff = $("#ff"); if (!ff) return;  ff.onclick = async () => {    ff.disabled = true;    try { const r = await api("fifty", { p_player: P.me.id, p_pin: P.pin, p_idx: qi });      P.fifty[qi] = r.hidden; P.fiftyUsed = r.used; applyFifty(qi);      const lim = +P.quiz.settings?.lifelines || 0; ff.innerHTML = `🎯 50:50 <span style="font-weight:600;font-size:14px">(${Math.max(0, lim - r.used)} left)</span>`; }    catch (e) { toast(errText(e)); if (!["NO_LIFELINES", "ALREADY_ANSWERED", "QUESTION_CLOSED"].includes(e.message)) ff.disabled = false; }  };}
/* ---------- STUDENT-PACED ---------- */function nextQuestion() {  stopPoll();  const idx = P.order.find(i => !P.doneSet.has(i));  if (idx === undefined) return finishScreen();  P.cur = idx; const q = P.qs[idx]; const n = P.doneSet.size + 1, N = P.quiz.q_count, tl = effTime(P.quiz.settings, q);  app.innerHTML = questionHTML(idx, `    <div class="qtop"><span class="chip">Q ${n}/${N}</span>${tl ? `<span class="chip" id="tsec">⏱ ${tl}s</span>` : ""}<span class="chip">🔥 ${P.me.streak || 0}</span><span class="chip gold">⭐ ${fmt(P.me.score)}</span></div>    <div class="prog"><i style="width:${(n - 1) / N * 100}%"></i></div>    ${tl ? `<div class="timer"><i id="tb"></i></div>` : ""}`);  P.t0 = performance.now(); P.locked = false;  app.querySelectorAll(".opt").forEach(b => b.onclick = () => answer(+b.dataset.i));  wireFifty(idx);  if (tl) {    const tb = $("#tb");    P.timerId = setInterval(() => {      const left = 1 - (performance.now() - P.t0) / (tl * 1000);      tb.style.width = Math.max(0, left * 100) + "%"; const ts = $("#tsec"); if (ts) ts.textContent = "⏱ " + Math.max(0, Math.ceil(left * tl)) + "s"; tb.style.background = left < .25 ? "#ef4444" : left < .5 ? "#f59e0b" : "#22c55e";      if (left <= 0) answer(-1);    }, 200);  }  startPoll(10000, async () => { await refreshState(); if ((P.quiz.status !== "live" || isTeacher()) && !P.locked) { clearInterval(P.timerId); route(); } });}async function answer(choice) {  if (P.locked) return; P.locked = true; stopPoll();  const ms = Math.round(performance.now() - P.t0), idx = P.cur;  const btns = [...app.querySelectorAll(".opt")]; if ($("#ff")) $("#ff").disabled = true;  btns.forEach((b, i) => { b.disabled = true; if (i !== choice) b.classList.add("dim"); });  let r, tries = 0;  while (true) {    try { r = await api("submit", { p_player: P.me.id, p_pin: P.pin, p_idx: idx, p_choice: choice, p_ms: ms }); break; }    catch (e) {      if (["QUIZ_NOT_LIVE", "QUESTION_CLOSED"].includes(e.message)) { await refreshState(); return r