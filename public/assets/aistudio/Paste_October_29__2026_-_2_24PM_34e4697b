function playerName() {  const saved = store.get(sessKey(P.quiz.code)) || {};  app.innerHTML = brand() + demoBanner() + `<div class="card">    <h2>${esc(P.quiz.title)}</h2><p class="sub">${P.quiz.q_count} questions · ${esc(timerLabel(P.quiz.settings))} · Code ${esc(P.quiz.code)}</p>    <label class="lbl">Your name</label><input class="inp" id="nm" maxlength="40" autocomplete="name" placeholder="e.g. Ravi Kumar (Branch 1234)" value="${esc(saved.name || "")}">    <label class="lbl">Choose a 4-digit PIN (to rejoin later)</label><input class="inp" id="pin" inputmode="numeric" maxlength="4" placeholder="••••" value="${esc(saved.pin || "")}">    <button class="btn block" id="go">Let's go 🚀</button>    <button class="btn block ghost" id="bk">Change code</button><div id="e"></div>    <p class="note">Remember your PIN. If your phone disconnects, enter the same code, name and PIN to resume.</p></div>`;  $("#bk").onclick = () => { history.replaceState(null, "", location.pathname); playerHome(); };  const go = async () => {    const name = $("#nm").value.trim(), pin = $("#pin").value.trim();    if (name.length < 2) return showErr(ERR.BAD_NAME);    if (!/^\d{4}$/.test(pin)) return showErr(ERR.BAD_PIN_FORMAT);    $("#go").disabled = true;    try {      const order = P.quiz.settings?.shuffle ? shuffled(P.quiz.q_count) : [];      const r = await api("join", { p_code: P.quiz.code, p_name: name, p_pin: pin, p_order: order });      P.pin = pin; setMe(r.player);      store.set(sessKey(P.quiz.code), { name: r.player.name, pin, id: r.player.id });      if (isTeacher() || P.quiz.status === "ended") return enterQuiz();      if (r.existing && r.player.answered > 0 && !r.player.finished) return resumeScreen();      if (r.existing && r.player.finished) return finishScreen();      enterQuiz();    } catch (e) { showErr(errText(e)); $("#go").disabled = false; }  };  $("#go").onclick = go; $("#pin").onkeydown = e =>    { if (e.key === "Enter") go(); };}const isTeacher = () => (P.quiz?.settings?.m