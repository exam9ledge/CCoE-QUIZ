/* ---- Excel parsing (3 formats) ---- */function parseWorkbook(wb) {  const sheets = wb.SheetNames.map(n => ({ name: n, rows: XLSX.utils.sheet_to_json(wb.Sheets[n], { header: 1, defval: "", raw: false }) }));  const norm = s => String(s ?? "").trim().toLowerCase().replace(/\s+/g, " ");  const findHeader = rows => { for (let r = 0; r < Math.min(rows.length, 15); r++) if (rows[r].some(c => /question/i.test(c) && !/^q\.?\s*no/i.test(norm(c)))) return r; return -1; };  // answer-key sheet (Q No → option letter / explanation)  const key = {};  for (const s of sheets) {    for (let r = 0; r < Math.min(s.rows.length, 15); r++) {      const h = s.rows[r].map(norm);      const qn = h.findIndex(c => /^q\.?\s*no|^q\s*#|^sr/.test(c)), co = h.findIndex(c => /correct option|^answer$|correct answer/.test(c));      if (qn >= 0 && co >= 0 && !h.some(c => /^question/.test(c))) {        const ex = h.findIndex(c => /explan/.test(c)), tp = h.findIndex(c => /topic/.test(c));        for (const row of s.rows.slice(r + 1)) { const n = parseInt(row[qn]); if (n) key[n] = { a: row[co], e: ex >= 0 ? row[ex] : "", t: tp >= 0 ? row[tp] : "" }; }        break;      }    }  }  let best = null;  for (const s of sheets) { const r = findHeader(s.rows); if (r >= 0) { best = { s, r }; break; } }  if (!best) throw new Error("Could not find a header row with a 'Question' column.");  const h = best.s.rows[best.r].map(norm);  const qc = h.findIndex(c => /question/.test(c) && !/^q\.?\s*no/.test(c) && !/type/.test(c));  const opt = [];  for (let i = 0; i < 5; i++) {    let c = h.findIndex(x => x === LET[i].toLowerCase() || x === "option " + LET[i].toLowerCase() || x === "option " + (i + 1) || x === "opt " + LET[i].toLowerCase() || x === "(" + LET[i].toLowerCase() + ")");    opt.push(c);  }  const ac = h.findIndex(c => /^(correct )?(answer|option)$|correct answer|correct option|^ans$|^key$/.test(c));  const ec = h.findIndex(c => /explan/.test(c)), tc = h.findIndex(c => /^topic|^section|^category|^subject/.test(c));  const nc = h.findIndex(c => /^q\.?\s*no|^sr/.test(c));  const sc = h.findIndex(c => /^time|timer|seconds|^secs?\b|duration/.test(c));  if (opt.filter(c => c >= 0).length < 2) throw new Error("Could not find option columns (A, B, C… or Option 1, Option 2…).");  const out = [], skipped = [];  best.s.rows.slice(best.r + 1).forEach((row, k) => {    const text = String(row[qc] ?? "").trim(); if (!text) return;    const o = [], map = [];    opt.forEach((c, i) => { if (c >= 0 && String(row[c] ?? "").trim() !== "") { map[i] = o.length; o.push(String(row[c]).trim()); } });    const qn = nc >= 0 ? parseInt(row[nc]) : k + 1;    let raw = ac >= 0 ? row[ac] : (key[qn] ? key[qn].a : "");    raw = String(raw ?? "").trim();    let a = -1;    if (/^[A-Ea-e]$/.test(raw)) a = map[LET.indexOf(raw.toUpperCase())];    else if (/^\(?[A-Ea-e]\)/.test(raw)) a = map[LET.indexOf(raw.replace("(", "")[0].toUpperCase())];    else if (/^[1-5]$/.test(raw)) a = map[+raw - 1];    else if (raw) a = o.findIndex(x => norm(x) === norm(raw));    if (o.length < 2 || a === undefined || a < 0) { skipped.push("row " + (best.r + k + 2) + (o.length < 2 ? " (options)" : " (answer)")); return; }    const e = ec >= 0 ? row[ec] : (key[qn]?.e || ""), t = tc >= 0 ? row[tc] : (key[qn]?.t || "");    const secs = sc >= 0 ? parseInt(String(row[sc]).replace(/[^\d]/g, "")) || 0 : 0;    out.push({ q: text, o, a, e: String(e || "").trim() || null, t: String(t || "").trim() || null, s: secs > 0 ? Math.min(secs, 3600) : null });  });  if (!out.length) throw new Error("No valid questions found. Check the answer column.");  return { questions: out, skipped };}
