/* ============================ confetti ============================ */function confetti(ms = 2500) {  const c = $("#confetti"); c.classList.remove("hidden"); const x = c.getContext("2d");  c.width = innerWidth; c.height = innerHeight;  const cols = ["#fbbf24", "#22c55e", "#3b82f6", "#ec4899", "#a855f7", "#f97316"];  const P = Array.from({ length: 160 }, () => ({ x: Math.random() * c.width, y: -20 - Math.random() * c.height * .5, r: 4 + Math.random() * 6,    vx: -2 + Math.random() * 4, vy: 2 + Math.random() * 4, a: Math.random() * 6, col: cols[Math.floor(Math.random() * cols.length)] }));  const end = performance.now() + ms;  (function f(t) {    x.clearRect(0, 0, c.width, c.height);    for (const p of P) { p.x += p.vx; p.y += p.vy; p.a += .1; x.save(); x.translate(p.x, p.y); x.rotate(p.a); x.fillStyle = p.col; x.fillRect(-p.r, -p.r / 2, p.r * 2, p.r); x.restore(); }    if (t < end) requestAnimationFrame(f); else c.classList.add("hidden");  })(performance.now());}
/* ============================ router ============================ */const app = $("#app");const params = new URLSearchParams(location.search);const isHost = /^#(host|admin)/.test(location.hash) || params.has("host") || params.has("admin");const brand = (extra = "") => `<div class="brand"><div class="bolt">⚡</div>QuizBlast${extra}</div>`;const demoBanner = () => DEMO ? `<div class="demo-banner">DEMO MODE – data stays in this browser only. Add Supabase keys for real phones.</div>` : "";
function needSetup() {  if (LIVE) return false;  app.innerHTML = brand() + `<div class="card"><h2>Setup needed</h2>    <p class="sub">This portal needs a free Supabase project so phones can connect.</p>    <ol class="note" style="font-size:14px;color:var(--ink);padding-left:18px;line-height:1.8">      <li>Create a free project at <b>supabase.com</b>.</li>      <li>Open <b>SQL Editor</b>, paste <b>supabase_setup.sql</b>, click <b>Run</b>.</li>      <li>Copy <b>Project URL</b> and <b>anon public key</b> (Project Settings → API) into the top of this file.</li>      <li>Upload this file to a free host (GitHub Pages / Netlify / Cloudflare Pages).</li></ol></div>`;  return true;}
/* ============================================================================   PLAYER   ============================================================================ */const P = { quiz: null, qs: null, me: null, pin: null, order: [], doneSet: new Set(), cur: null, t0: 0, timerId: null, pollId: null, results: {} };const sessKey = code => "qb_player_" + code;
