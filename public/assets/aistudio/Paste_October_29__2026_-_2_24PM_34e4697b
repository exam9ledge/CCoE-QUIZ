/* ---------- FINISH (both modes) ---------- */async function finishScreen() {  stopPoll();  await refreshState();  const ended = P.quiz.status === "ended";  if (ended) { try { const me = await api("join", { p_code: P.quiz.code, p_name: P.me.name, p_pin: P.pin, p_order: [] }); Object.assign(P.me, me.player); } catch {} }  const m = P.me, acc = m.answered ? Math.round(m.correct / m.answered * 100) : 0;  const wrongs = Object.entries(P.results).filter(([, v]) => !v.ok);  app.innerHTML = brand() + `<div class="card center">    <div class="big-emoji">${acc >= 80 ? "🏆" : acc >= 50 ? "🎯" : "💪"}</div>    <h2>${ended ? "Quiz over, " + esc(m.name) + "!" : "Well done, " + esc(m.name) + "!"}</h2>    <p class="sub" id="rk">Fetching your rank<span class="dots"></span></p>    <div id="top3"></div>    <div class="stats"><div class="stat"><b>${fmt(m.score)}</b><span>Score</span></div><div class="stat"><b style="color:var(--ok)">${m.correct}</b><span>Correct</span></div><div class="stat"><b style="color:var(--bad)">${m.wrong}</b><span>Wrong</span></div>    <div class="stat"><b>${acc}%</b><span>Accuracy</span></div><div class="stat"><b>${m.answered}/${P.quiz.q_count}</b><span>Answered</span></div><div class="stat"><b>🔥${m.best_streak || 0}</b><span>Best streak</span></div></div>    ${!ended && !isTeacher() && m.answered < P.quiz.q_count ? `<button class="btn block green" id="cont">Continue quiz ➜</button>` : ""}    ${wrongs.length && P.qs ? `<div class="review" style="text-align:left"><b>Review your mistakes (${wrongs.length})</b>${wrongs.map(([i, v]) => {      const q = P.qs[i]; return `<div class="it">${esc(q.q)}<div class="w">Your answer: ${v.c >= 0 ? "(" + LET[v.c] + ") " + esc(q.o[v.c]) : "No answer (time up)"}</div><div class="c">Correct: (${LET[v.a]}) ${esc(q.o[v.a])}</div></div>`; }).join("")}</div>` : ""}  </div>`;  if ($("#cont")) $("#cont").onclick = () => route();  if (acc >= 50 && m.answered) confetti();  const upd = async () => { try { const r = await api("my_rank", { p